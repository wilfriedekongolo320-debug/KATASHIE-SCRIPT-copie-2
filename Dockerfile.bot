FROM python:3.11-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends openssh-client curl && rm -rf /var/lib/apt/lists/*
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY . .
# The docker-compose service explicitly sets the Python script to run.
# Do not force main.py here; the project ships bot files named katashie_bot.py,
# deploy_bot.py and whatsapp_bot.py instead.
